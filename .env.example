# Robinhood Chain RPC (chainId 4663). Defaults to the public endpoint.
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional: block explorer base URL (no trailing slash). Enables tx/address links.
VITE_EXPLORER_URL=
# Optional: public site URL used for link-preview images (no trailing slash).
# On Vercel it is detected automatically.
VITE_SITE_URL=
# Server-side only (Vercel Function api/upload): added automatically when a
# Vercel Blob store is connected to the project. Never prefix it with VITE_.
# BLOB_READ_WRITE_TOKEN=
